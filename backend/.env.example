# ─────────────────────────────────────────────
#  DESTTEK — Environment Configuration
#  Rename this file to .env before running
#  NEVER commit .env to version control
# ─────────────────────────────────────────────

# App identity (change freely)
APP_NAME=DESTTEK
APP_VERSION=1.0.0

# Server
PORT=3000
NODE_ENV=production

# Security — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=8h

# Admin credentials — change before first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Database
DB_PATH=./data/desttek.db

# CORS — alan adını buraya yaz (örn: https://desttek.com,https://www.desttek.com)
ALLOWED_ORIGINS=https://alanadin.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=200
RATE_LIMIT_MAX_ADMIN=50
RATE_LIMIT_MAX_AUTH=10

# Backup
BACKUP_DIR=./data/backups
